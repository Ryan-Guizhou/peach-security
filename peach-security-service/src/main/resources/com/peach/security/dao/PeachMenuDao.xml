    <select id="selectByRoleCodeList" resultType="com.peach.security.vo.MenuVO" parameterType="java.util.List">
        SELECT DISTINCT m.MENU_ID As "menuId",
        m.PARENT_MENU_ID as "parentMenuId",
        m.MENU_NAME as "menuName",
        m.MENU_PARAM as "menuParam",
        m.MENU_URL as "menuUrl",
        m.IS_LEAF as "isLeaf",
        m.MENU_LEVEL as "menuLevel",
        m.MENU_SEQ as "menuSeq",
        (CASE WHEN m.IS_SHOW is null then 1 else m.IS_SHOW end ) as "isShow",
        f.FUNC_CODE AS "funcCode",
        m.FUNC_CODE,
        m.SORT_NO AS "sortNo",
        m.MENU_ICON as "menuIcon"
        FROM PEACH_MENU m
        LEFT JOIN PEACH_APP_FUNCTION f ON m.FUNC_CODE = f.FUNC_CODE
        LEFT JOIN PEACH_AUTH_FUNCTION af ON f.FUNC_CODE = af.FUNC_CODE
        WHERE af.PARTY_CODE IN
        <foreach collection="roleCodeList" index="index" item="roleCode" open="(" separator="," close=")">
            #{roleCode,jdbcType=VARCHAR}
        </foreach>
        AND (m.IS_DELETE IS NULL OR m.IS_DELETE != 1)
        AND (f.IS_DELETE IS NULL OR f.IS_DELETE != 1)
        AND (m.IS_DISABLE = 0 or m.IS_DISABLE is NULL)
        AND (af.IS_DELETE IS NULL OR af.IS_DELETE != 1)
        order by m.SORT_NO

    </select>
